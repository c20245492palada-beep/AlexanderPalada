---
const projects = [
  {
    title: "AI Tools",
    description: "Helpful AI features designed around real user needs.",
  },
  {
    title: "Web Apps",
    description: "Simple, responsive websites and applications for small teams.",
  },
  {
    title: "Automation",
    description: "Workflows that reduce repetitive tasks and save time.",
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Alexander Palada | AI Engineer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#home">Alexander Palada</a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="theme-toggle" type="button" aria-pressed="false">
        Toggle Dark Mode
      </button>
    </header>
    <main id="home">
      <section class="hero">
        <span class="hero-kicker">
          <span class="hero-kicker-dot" aria-hidden="true"></span>
          AI ENGINEER · DIGITAL PRODUCT BUILDER
        </span>
        <h1
          data-scramble="Alexander Palada"
          aria-label="Alexander Palada"
        >Alexander Palada</h1>
        <p>
          AI Engineer building useful digital products for people and small
          businesses.
        </p>
        <a class="text-link" href="#contact">
          Get in touch <span aria-hidden="true">↗</span>
        </a>
      </section>

      <section class="content-section" id="about">
        <h2>About</h2>
        <p>
          I build AI-powered tools and web experiences, focusing on making
          technology clear, practical, and easy to use.
        </p>
      </section>

      <section class="content-section" id="work">
        <h2>Work</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section contact" id="contact">
        <div class="contact-card">
          <h2>Contact</h2>
          <p class="contact-intro">
            Have a project in mind?{" "}
            <a href="mailto:hello@example.com">Email me.</a>
          </p>
          <form
            class="contact-form"
            id="contact-form"
            action="/api/contact"
            method="POST"
          >
            <input
              class="contact-honeypot"
              type="text"
              name="website"
              tabindex="-1"
              autocomplete="off"
              aria-hidden="true"
            />
            <div class="contact-field">
              <label for="contact-name">Name</label>
              <input
                id="contact-name"
                name="name"
                type="text"
                autocomplete="name"
                placeholder="Your name"
                required
              />
            </div>

            <div class="contact-field">
              <label for="contact-email">Email</label>
              <input
                id="contact-email"
                name="email"
                type="email"
                autocomplete="email"
                placeholder="you@example.com"
                required
              />
            </div>

            <div class="contact-field contact-field-message">
              <label for="contact-message">Message:</label>
              <textarea
                id="contact-message"
                name="message"
                rows="4"
                placeholder="Tell me about your project"
                required
              ></textarea>
            </div>

            <button type="submit">Send message</button>
          </form>
          <span class="contact-leaf leaf-one" aria-hidden="true"></span>
          <span class="contact-leaf leaf-two" aria-hidden="true"></span>
          <span class="contact-leaf leaf-three" aria-hidden="true"></span>
          <span class="contact-leaf leaf-four" aria-hidden="true"></span>
        </div>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Alexander Palada</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    font-family: Arial, Helvetica, sans-serif;
    color: #171717;
    background: #f7f6f3;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --page: #f7f6f3;
    --text: #171923;
    --muted: #69717e;
    --card: #fff;
    --surface: #fff;
    --border: #e7e3dc;
  }
  :root.dark {
    color: #f5f5f5;
    background: #10141d;
    --page: #10141d;
    --text: #f5f5f5;
    --muted: #acb2bb;
    --card: #1d2330;
    --surface: #191f2a;
    --border: #303744;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
    scroll-padding-top: 82px;
  }
  body {
    min-height: 100vh;
    margin: 0;
    background:
      radial-gradient(ellipse at 82% 10%, #f3a64e1a, transparent 30%),
      var(--page);
    color: var(--text);
    font-size: 14px;
    transition: background 180ms ease, color 180ms ease;
  }
  a {
    color: inherit;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    min-height: 56px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-shadow: 0 8px 24px #11182714;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a,
  .text-link {
    text-decoration: none;
    transition: color 180ms ease, transform 180ms ease, background 180ms ease;
  }

  nav a {
    font-size: 12px;
  }

  nav a:hover,
  .text-link:hover {
    color: #f3a64e;
  }

  nav a:hover {
    transform: translateY(-2px);
  }

  .theme-toggle {
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--card);
    color: var(--text);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
    transition: transform 180ms ease, background 180ms ease;
  }

  .theme-toggle:hover {
    transform: translateY(-2px);
    background: #facc15;
    color: #111827;
  }

  main {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 270px;
    padding: 92px 0 76px;
    text-align: center;
  }

  .hero::before {
    position: absolute;
    z-index: -1;
    top: 26px;
    left: 50%;
    width: min(390px, 85vw);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #f3a64e24, #f3a64e00 70%);
    content: "";
    transform: translateX(-50%);
    animation: hero-glow 8s ease-in-out infinite alternate;
  }

  .hero-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    color: #8a5a24;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .hero-kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #f3a64e;
    box-shadow: 0 0 0 4px #f3a64e26;
    animation: kicker-pulse 2.4s ease-in-out infinite;
  }

  .hero h1 {
    margin: 0 0 10px;
    background: linear-gradient(110deg, #171923 28%, #a96425 78%);
    background-clip: text;
    color: transparent;
    font-size: clamp(42px, 7vw, 62px);
    letter-spacing: -0.065em;
    line-height: 1.05;
    background-size: 220% 100%;
    animation: headline-shimmer 7s ease-in-out infinite;
    -webkit-background-clip: text;
  }

  :root.dark .hero h1 {
    background-image: linear-gradient(110deg, #f5f5f5 28%, #f3a64e 82%);
  }

  .hero p {
    max-width: 440px;
    margin: 0 auto 20px;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.7;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 18px;
    border-radius: 999px;
    background: #111827;
    color: #fff;
    font-size: 13px;
    font-weight: 600;
  }

  .text-link span {
    color: #f3a64e;
    font-size: 16px;
  }

  .text-link:hover {
    background: #263248;
    color: #fff;
    transform: translateY(-2px);
  }

  .content-section {
    padding: 20px 0;
    scroll-margin-top: 20px;
  }

  .content-section h2 {
    margin: 0 0 10px;
    font-size: 22px;
    letter-spacing: -0.035em;
  }

  .content-section > p {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.75;
  }

  #about {
    padding: 24px;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: var(--surface);
    box-shadow: 0 14px 40px #1118270a;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    min-height: 100px;
    padding: 20px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--card);
    box-shadow: 0 12px 28px #1118270a;
    transition:
      transform 240ms ease,
      box-shadow 240ms ease,
      border-color 240ms ease;
  }

  .project-card::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 3px;
    background: linear-gradient(90deg, #f3a64e, #facc15, transparent);
    content: "";
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 240ms ease;
  }

  .project-card:hover {
    transform: translateY(-6px);
    border-color: #efc58d;
    box-shadow: 0 20px 36px #11182718;
  }

  .project-card:hover::before {
    transform: scaleX(1);
  }

  .project-card h3 {
    margin: 0 0 8px;
    font-size: 15px;
  }

  .project-card p {
    margin: 0;
    color: var(--muted);
    font-size: 12px;
    line-height: 1.7;
  }

  .contact {
    padding-bottom: 36px;
  }

  .contact-card {
    position: relative;
    overflow: hidden;
    padding: 24px;
    border: 1px solid #594236;
    border-radius: 24px;
    background: #281d18;
    color: #f6eee8;
  }

  .contact-card > :not(.contact-leaf) {
    position: relative;
    z-index: 1;
  }

  .contact-card h2 {
    margin: 0 0 8px;
  }

  .contact .contact-intro {
    margin: 0 0 16px;
    color: #cfb7a4;
    font-size: 12px;
  }

  .contact-intro a {
    color: #ff9b45;
    font-weight: 700;
    text-decoration: none;
  }

  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px 8px;
  }

  .contact-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .contact-field {
    display: grid;
    min-width: 0;
    gap: 6px;
  }

  .contact-field-message {
    grid-column: 1 / -1;
  }

  .contact-field label {
    font-size: 10px;
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    padding: 9px 10px;
    border: 1px solid #594236;
    border-radius: 10px;
    background: #3a2a23;
    color: #f6eee8;
    font: inherit;
    font-size: 10px;
  }

  .contact-form input::placeholder,
  .contact-form textarea::placeholder {
    color: #c1a894;
  }

  .contact-form textarea {
    min-height: 80px;
    resize: vertical;
  }

  .contact-form input:focus-visible,
  .contact-form textarea:focus-visible,
  .contact-form button:focus-visible {
    outline: 2px solid #f3a64e;
    outline-offset: 2px;
  }

  .contact-form button {
    justify-self: start;
    margin-top: 2px;
    padding: 9px 16px;
    border: 0;
    border-radius: 999px;
    background: #f3a64e;
    color: #281d18;
    font: inherit;
    font-size: 10px;
    font-weight: 600;
    cursor: pointer;
  }

  .contact-leaf {
    position: absolute;
    z-index: 0;
    width: 7px;
    height: 10px;
    border-radius: 100% 0 100% 0;
    pointer-events: none;
  }

  .leaf-one {
    top: 8px;
    right: 12px;
    background: #d85143;
    transform: rotate(30deg);
  }

  .leaf-two {
    top: 42%;
    right: 9%;
    background: #e28a35;
    transform: rotate(60deg);
  }

  .leaf-three {
    right: 23%;
    bottom: 18%;
    background: #bd3445;
    transform: rotate(-35deg);
  }

  .leaf-four {
    top: 1px;
    left: 28%;
    width: 5px;
    height: 7px;
    background: #d88a21;
    transform: rotate(35deg);
  }

  .contact-leaf {
    animation: leaf-drift 4s ease-in-out infinite alternate;
  }

  .leaf-two {
    animation-delay: -1.2s;
  }

  .leaf-three {
    animation-delay: -2.4s;
  }

  .leaf-four {
    animation-delay: -0.8s;
  }

  @keyframes hero-glow {
    from {
      opacity: 0.65;
      transform: translateX(-50%) scale(0.92);
    }

    @keyframes kicker-pulse {
      50% {
        box-shadow: 0 0 0 7px #f3a64e10;
        transform: scale(0.82);
      }
    }

    @keyframes headline-shimmer {
      from {
        background-position: 0% 50%;
      }

      to {
        background-position: 100% 50%;
      }
    }

    to {
      opacity: 1;
      transform: translateX(-50%) scale(1.08);
    }
  }

  @keyframes leaf-drift {
    from {
      translate: 0 0;
    }

    to {
      translate: 5px -6px;
    }
  }

  footer {
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding: 18px 24px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
  }

  footer p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .site-header {
      flex-wrap: wrap;
      justify-content: center;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .brand {
      width: 100%;
      text-align: center;
    }

    nav {
      gap: 14px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 230px;
      padding-top: 60px;
    }

    .contact {
      margin-inline: -18px;
    }

    .contact-card {
      padding: 20px;
    }
  }

  @media (max-width: 420px) {
    .contact-form {
      grid-template-columns: 1fr;
    }

    .contact-field-message {
      grid-column: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
      transition-duration: 0.01ms !important;
    }
  }
  .site-header {
  width: 100%;
  max-width: none;
  min-height: 56px;
  margin: 0;
  padding: 10px clamp(16px, 5vw, 64px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: #111827;
  color: #fff;
}

.brand {
  padding: 8px 14px;
  border-radius: 999px;
  background: #facc15;
  color: #111827;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

nav a {
  color: #e5e7eb;
  font-size: 12px;
  text-decoration: none;
}

nav a:hover {
  color: #facc15;
}

@media (max-width: 600px) {
  .site-header {
    flex-wrap: wrap;
    justify-content: center;
  }

  nav {
    order: 3;
    width: 100%;
    justify-content: center;
    gap: 14px;
  }
}
</style>
<script>
  import { FallingLeaves } from "falling-leaves";

  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    toggle.setAttribute("aria-pressed", String(isDark));
  });

  const style = document.createElement("style");
  style.textContent = `
    #scroll-progress {
      position: fixed;
      inset: 0 auto auto 0;
      z-index: 9999;
      width: 100%;
      height: 4px;
      background: #f3a64e;
      transform: scaleX(0);
      transform-origin: left;
      pointer-events: none;
    }

    .animate-on-scroll {
      opacity: 0;
      transform: translateY(28px) scale(0.98);
      transition:
        opacity 700ms cubic-bezier(0.2, 0.65, 0.3, 1),
        transform 700ms cubic-bezier(0.2, 0.65, 0.3, 1);
    }

    .animate-on-scroll.is-visible {
      opacity: 1;
      transform: translateY(0) scale(1);
    }

    @media (prefers-reduced-motion: reduce) {
      .animate-on-scroll {
        opacity: 1;
        transform: none;
        transition: none;
      }
    }
  `;
  document.head.appendChild(style);

  const progressBar = document.createElement("div");
  progressBar.id = "scroll-progress";
  progressBar.setAttribute("aria-hidden", "true");
  document.body.prepend(progressBar);

  function updateProgress() {
    const maxScroll =
      document.documentElement.scrollHeight - window.innerHeight;
    const progress = maxScroll > 0 ? window.scrollY / maxScroll : 0;
    progressBar.style.transform = `scaleX(${progress})`;
  }

  let frameRequested = false;

  window.addEventListener(
    "scroll",
    () => {
      if (frameRequested) return;
      frameRequested = true;
      window.requestAnimationFrame(() => {
        updateProgress();
        frameRequested = false;
      });
    },
    { passive: true }
  );

  window.addEventListener("resize", updateProgress);
  updateProgress();

  const items = document.querySelectorAll(
    ".hero h1, .hero p, .hero .text-link, .content-section, footer"
  );

  const reducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)"
  ).matches;

  if (!reducedMotion) {
    new FallingLeaves({
      count: 16,
      size: [12, 21],
      speed: [0.5, 1],
      wind: [-0.25, 0.35],
      opacity: 0.78,
      colors: ["#d85143", "#e28a35", "#d88a21", "#b9563c"],
      shapes: ["maple", "oak", "ginkgo", "birch", "oval"],
      zIndex: 0,
      respectReducedMotion: true,
    });
  }

  const scrambleHeading =
    document.querySelector<HTMLElement>("[data-scramble]");
  if (scrambleHeading && !reducedMotion) {
    const finalText =
      scrambleHeading.dataset.scramble ?? scrambleHeading.textContent ?? "";
    const characters = "ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!@#$%&*";
    const duration = 1100;
    let startedAt = 0;

    function scrambleFrame(now: number) {
      if (!startedAt) startedAt = now;
      const progress = Math.min((now - startedAt) / duration, 1);
      const lockedCount = Math.floor(progress * finalText.length);
      scrambleHeading.textContent = [...finalText]
        .map((character, index) => {
          if (character === " " || index < lockedCount) return character;
          return characters[Math.floor(Math.random() * characters.length)];
        })
        .join("");

      if (progress < 1) {
        window.requestAnimationFrame(scrambleFrame);
      } else {
        scrambleHeading.textContent = finalText;
      }
    }

    window.setTimeout(() => window.requestAnimationFrame(scrambleFrame), 250);
  }

  if (reducedMotion) {
    items.forEach((item) => item.classList.add("is-visible"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    items.forEach((item) => {
      item.classList.add("animate-on-scroll");
      observer.observe(item);
    });
  }
</script>