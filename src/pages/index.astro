---
const projects = [
  {
    title: "AI Tools",
    description: "Helpful AI features designed around real user needs.",
  },
  {
    title: "Web Apps",
    description: "Simple, responsive websites and applications for small teams.",
  },
  {
    title: "Automation",
    description: "Workflows that reduce repetitive tasks and save time.",
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Alexander Palada | AI Engineer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#home">Alexander Palada</a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="theme-toggle" type="button" aria-pressed="false">
        Toggle Dark Mode
      </button>
    </header>
    <main id="home">
      <section class="hero">
        <h1>Alexander Palada</h1>
        <p>
          AI Engineer building useful digital products for people and small
          businesses.
        </p>
        <a class="text-link" href="#contact">Get in touch</a>
      </section>

      <section class="content-section" id="about">
        <h2>About</h2>
        <p>
          I build AI-powered tools and web experiences, focusing on making
          technology clear, practical, and easy to use.
        </p>
      </section>

      <section class="content-section" id="work">
        <h2>Work</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section contact" id="contact">
        <h2>Contact</h2>
        <p>Have an idea or project in mind?</p>
        <a class="text-link" href="mailto:hello@example.com">Send me an email</a>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Alexander Palada</p>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    toggle.setAttribute("aria-pressed", String(isDark));
  });
</script>

<style is:global>
  :root {
    font-family: Arial, Helvetica, sans-serif;
    color: #171717;
    background: #fff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --page: #fff;
    --text: #171717;
    --muted: #656565;
    --card: #f0f0f2;
    --border: #e8e8eb;
  }
  :root.dark {
    color: #f5f5f5;
    background: #151515;
    --page: #151515;
    --text: #f5f5f5;
    --muted: #b6b6b6;
    --card: #242424;
    --border: #343434;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    min-height: 100vh;
    margin: 0;
    background: var(--page);
    color: var(--text);
    font-size: 14px;
    transition: background 180ms ease, color 180ms ease;
  }
  a {
    color: inherit;
  }
  .site-header {
    min-height: 56px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
    gap: 20px;
  }

  nav a,
  .text-link {
    text-decoration: none;
  }

  nav a {
    font-size: 12px;
  }

  nav a:hover,
  .text-link:hover {
    text-decoration: underline;
  }

  .theme-toggle {
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--card);
    color: var(--text);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    min-height: 270px;
    padding: 80px 0 60px;
    text-align: center;
  }

  .hero h1 {
    margin: 0 0 10px;
    font-size: clamp(30px, 6vw, 42px);
    letter-spacing: -1.5px;
  }

  .hero p {
    max-width: 440px;
    margin: 0 auto 20px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .text-link {
    font-size: 12px;
    font-weight: 600;
  }

  .content-section {
    padding: 20px 0;
    scroll-margin-top: 20px;
  }

  .content-section h2 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .content-section > p {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .project-card {
    min-height: 100px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }

  .project-card h3 {
    margin: 0 0 8px;
    font-size: 13px;
  }

  .project-card p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .contact {
    padding-bottom: 36px;
  }

  .contact .text-link {
    display: inline-block;
    margin-top: 12px;
  }

  footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 18px 24px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
  }

  footer p {
    margin: 0;
  }

  @media (max-width: 600px) {
    .site-header {
      flex-wrap: wrap;
      justify-content: center;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .brand {
      width: 100%;
      text-align: center;
    }

    nav {
      gap: 14px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 230px;
      padding-top: 60px;
    }
  }
</style>