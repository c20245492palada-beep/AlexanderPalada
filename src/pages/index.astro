  }

  nav a:hover,
  .text-link:hover {
    text-decoration: underline;
  }

  .theme-toggle {
    padding: 6px 9px;
    border: 1px solid var(--border);
    border-radius: 5px;
    background: var(--card);
    color: var(--text);
    font: inherit;
    font-size: 11px;
    cursor: pointer;
  }

  main {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .hero {
    min-height: 270px;
    padding: 80px 0 60px;
    text-align: center;
  }

  .hero h1 {
    margin: 0 0 10px;
    font-size: clamp(30px, 6vw, 42px);
    letter-spacing: -1.5px;
  }

  .hero p {
    max-width: 440px;
    margin: 0 auto 20px;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .text-link {
    font-size: 12px;
    font-weight: 600;
  }

  .content-section {
    padding: 20px 0;
    scroll-margin-top: 20px;
  }

  .content-section h2 {
    margin: 0 0 10px;
    font-size: 18px;
  }

  .content-section > p {
    max-width: 600px;
    margin: 0;
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin-top: 14px;
  }

  .project-card {
    min-height: 100px;
    padding: 16px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--card);
  }

  .project-card h3 {
    margin: 0 0 8px;
    font-size: 13px;
  }

  .project-card p {
    margin: 0;
    color: var(--muted);
    font-size: 11px;
    line-height: 1.5;
  }

  .contact {
    padding-bottom: 36px;
  }

  .contact .text-link {
    display: inline-block;
    margin-top: 12px;
  }

  footer {
    max-width: 760px;
    margin: 0 auto;
    padding: 18px 24px;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 11px;
  }

  footer p {
    margin: 0;
  }

