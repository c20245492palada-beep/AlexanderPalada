    .site-header {
      flex-wrap: wrap;
      justify-content: center;
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .brand {
      width: 100%;
      text-align: center;
    }

    nav {
      gap: 14px;
    }

    .project-grid {
      grid-template-columns: 1fr;
    }

    .hero {
      min-height: 230px;
      padding-top: 60px;
    }
  }
  .site-header {
  width: 100%;
  min-height: 56px;
  margin: 0;
  padding: 10px clamp(16px, 5vw, 64px);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  background: #111827;
  color: #fff;
}

.brand {
  padding: 8px 14px;
  border-radius: 999px;
  background: #facc15;
  color: #111827;
  font-weight: 700;
  text-decoration: none;
  white-space: nowrap;
}

nav {
  display: flex;
  align-items: center;
  gap: 20px;
}

nav a {
  color: #e5e7eb;
  font-size: 12px;
  text-decoration: none;
}

nav a:hover {
