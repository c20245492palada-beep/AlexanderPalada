---
import "../scripts/animations.js";
const projects = [
  {
    title: "AI Tools",
    description: "Helpful AI features designed around real user needs.",
  },
  {
    title: "Web Apps",
    description: "Simple, responsive websites and applications for small teams.",
  },
  {
    title: "Automation",
    description: "Workflows that reduce repetitive tasks and save time.",
  },
];
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <title>Alexander Palada | AI Engineer</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="#home">Alexander Palada</a>
      <nav aria-label="Main navigation">
        <a href="#about">About</a>
        <a href="#work">Work</a>
        <a href="#contact">Contact</a>
      </nav>
      <button class="theme-toggle" type="button" aria-pressed="false">
        Toggle Dark Mode
      </button>
    </header>
    <main id="home">
      <section class="hero">
        <h1>Alexander Palada</h1>
        <p>
          AI Engineer building useful digital products for people and small
          businesses.
        </p>
        <a class="text-link" href="#contact">Get in touch</a>
      </section>

      <section class="content-section" id="about">
        <h2>About</h2>
        <p>
          I build AI-powered tools and web experiences, focusing on making
          technology clear, practical, and easy to use.
        </p>
      </section>

      <section class="content-section" id="work">
        <h2>Work</h2>
        <div class="project-grid">
          {projects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="content-section contact" id="contact">
        <h2>Contact</h2>
        <p>Have an idea or project in mind?</p>
        <a class="text-link" href="mailto:hello@example.com">Send me an email</a>
      </section>
    </main>

    <footer>
      <p>© {new Date().getFullYear()} Alexander Palada</p>
    </footer>
  </body>
</html>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");

  toggle?.addEventListener("click", () => {
    const isDark = document.documentElement.classList.toggle("dark");
    toggle.setAttribute("aria-pressed", String(isDark));
  });
</script>

<style is:global>
  :root {
    font-family: Arial, Helvetica, sans-serif;
    color: #171717;
    background: #fff;
    font-synthesis: none;
    text-rendering: optimizeLegibility;
    --page: #fff;
    --text: #171717;
    --muted: #656565;
    --card: #f0f0f2;
    --border: #e8e8eb;
  }
  :root.dark {
    color: #f5f5f5;
    background: #151515;
    --page: #151515;
    --text: #f5f5f5;
    --muted: #b6b6b6;
    --card: #242424;
    --border: #343434;
  }

  * {
    box-sizing: border-box;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    min-height: 100vh;
    margin: 0;
    background: var(--page);
    color: var(--text);
    font-size: 14px;
    transition: background 180ms ease, color 180ms ease;
  }
  a {
    color: inherit;
  }
  .site-header {
    min-height: 56px;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .brand {
    font-weight: 700;
    text-decoration: none;
  }

  nav {
    display: flex;
