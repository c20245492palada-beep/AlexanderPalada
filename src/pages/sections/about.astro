---
const navItems = [
  { label: "About", href: "#about" },
  { label: "Projects", href: "#projects" },
  { label: "Contact", href: "#contact" },
];
---

<header class="site-header">
  <div class="brand">
    <span class="dot"></span>
    <a href="/">Alexander Palada</a>
  </div>

  <nav class="nav" aria-label="Main navigation">
    {navItems.map((item) => (
      <a href={item.href}>{item.label}</a>
    ))}
  </nav>

  <a class="button primary" href="#contact">Hire Me</a>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 5vw;
    position: sticky;
    top: 0;
    background: rgba(10, 10, 10, 0.78);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    z-index: 20;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .brand a {
    color: #f5f5f5;
    text-decoration: none;
  }

  .dot {
    width: 10px;
    height: 10px;
    background: linear-gradient(135deg, #7c3aed, #22d3ee);
    border-radius: 50%;
    display: inline-block;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .nav a {
    color: #d1d5db;
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: #ffffff;
  }

  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.8rem 1.2rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .button:hover {
    transform: translateY(-1px);
  }

  .button.primary {
    background: linear-gradient(135deg, #7c3aed, #2563eb);
    color: white;
  }

  @media (max-width: 700px) {
    .site-header {
      flex-wrap: wrap;
      justify-content: center;
    }

    .nav {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }
  }
</style>